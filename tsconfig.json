{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "codeappscompact": ["./src/index.tsx"]
    }
  },
  "include": ["src", "examples", "tests", "vite.config.ts"]
}
