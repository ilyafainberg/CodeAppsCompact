{
  "name": "codeappscompact",
  "version": "0.1.2",
  "description": "Bundled React/TypeScript record-screen kit for Power Platform Code Apps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "API.txt",
    "examples"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyafainberg/CodeAppsCompact.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "prepack": "npm run build",
    "bundle:skill": "npm run build && node scripts/bundle-skill.mjs"
  },
  "peerDependencies": {
    "@microsoft/power-apps": "^1.5.0",
    "@tanstack/react-query": ">=5.90.5 <6",
    "react": ">=18.3.1 <20"
  },
  "devDependencies": {
    "@microsoft/power-apps": "1.5.0",
    "@tanstack/react-query": "5.90.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  },
  "private": true
}
